<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Buyer – Ntec Seller</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <style>
    .color-success {
      background: rgba(208, 239, 160, 0.8);
    }
    :root {
      --brand: #7c3aed;
      --brand2: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #7c3aed, #4f46e5);
      color: #fff;
      padding: 40px 0;
    }

    /* Stat cards */
    .stat-card {
      background: #fff;
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
      transition: all 0.5s ease-in;
    }
    .stat-card:hover {
      transform: translateY(-3px);

    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    /* Table container */
    .table-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      overflow: hidden;
    }

    /* ============================================================
       RESPONSIVE TABLE — works down to 320px
       The table-responsive div adds overflow-x:auto only when needed.
       Column widths are controlled with white-space:nowrap to prevent
       text wrapping that would make rows taller and harder to scan.
    ============================================================ */
    .orders-table thead {
      background: #f8f8ff;
    }

    .orders-table th {
      font-size: .82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: #6b7280;
      padding: 14px 16px;
      white-space: nowrap;
      border-bottom: 2px solid #e5e7eb;
    }

    .orders-table td {
      padding: 14px 16px;
      vertical-align: middle;
      border-bottom: 1px solid #f3f4f6;
      white-space: nowrap;
    }

    .orders-table tr:last-child td {
      border-bottom: none;
    }

    .orders-table tbody tr:hover {
      background: #fafbff;
    }

    /* Status badges */
    .status-badge {
      padding: 4px 12px;
      border-radius: 50px;
      font-size: .76rem;
      font-weight: 600;
    }

    /* Search & filter bar */
    .filter-bar {
      background: #fff;
      border-radius: 14px;
      padding: 14px 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .form-control,
    .form-select {
      border-radius: 10px;
      border: 2px solid #e5e7eb;
      padding: 9px 14px;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(124, 58, 237, .08);
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-seller') %>

    <!-- PAGE HEADER -->
    <section class="page-header">
      <div class="container-xl">
        <h4 class="fw-bold mb-1">Orders of your customer</h4>
        <p class="mb-0 opacity-75">View and manage all customer orders for your store</p>
      </div>
    </section>

    <div class="container-xl py-4">

      <!-- STAT CARDS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="fa fa-receipt"></i></div>
            <div>
              <% function getcount(status){ const found=counts.find(c=> c.status === status)
                return found ? found.total : 0;
                }
                %>
                <% if( show.length=== 0 ){%>
                <div class="fw-bold fs-5 ">0</div>
                <% } else{ %>
                  <div class="fw-bold fs-5 totalorders"><%= show[0].result %></div>
               <% } %>
                <div class="small text-muted">All Orders</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#fef9c3;color:#854d0e;"><i class="fa fa-hourglass-half"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('pending') %>
              </div>
              <div class="small text-muted">Pending</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#dbeafe;color:#1e40af;"><i class="fa fa-truck"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('order confirm') %>
              </div>
              <div class="small text-muted">Order confirm</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#dcfce7;color:#166534;"><i class="fa fa-check"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('delivered') %>
              </div>
              <div class="small text-muted">Delivered</div>
            </div>
          </div>
        </div>
      </div>

<div class="container">
  <div class="d-flex justify-content-around align-items-center">
    <div class="text-center p-2"> <h2 style="color: #4f46e5;">Your Customers</h2></div>
    <form  class="d-flex ">
        <input type="text" name="se" id="SearchInput" placeholder="Search customer.." class="form-control">
    </form>
  </div>

</div>
      <!-- STATUS TABS -->
    

      <!-- ORDERS TABLE — fully responsive, scrolls at any width down to 320px -->

      <div class="table-card">
        <div class="table-responsive">
          <% if(show.length===0){ %>
            <div class="text-danger text-center mt-4">
              <i class="fa fa-frown h2"></i>
              <h2 class="fw-bold">No Customer found</h2>
            </div>
            <% } else { %>
              <table class="table orders-table mb-0">
                <thead>
                  <tr>
                    <th>Buyer Id</th>
                    <th>Buyer Name</th>
                    <th>Buyer Email</th>
                    <th>Buyer Orders</th>
                    <th>View Order</th>
                  </tr>
                </thead>
                <tbody id="resultBody">
                  <% for(let i = 0; i < show.length; i++){ %>
                    <tr data-search="<%= show[i].id %> <%= show[i].username %> <%= show[i].email %>">
                  <td><%= show[i].id %></td>
                  <td><%= show[i].username %></td>
                  <td><%= show[i].email %></td>
                  <td><%= show[i].total %></td>
                  <td>  
                    <a href="/view_buyer_order/<%= show[i].id %>" class="btn btn-primary">View order</a>
                  </td>
                  </tr>
                  <% }%>
                </tbody>
              </table>
              <% } %>
        </div><!-- /table-responsive -->
      </div><!-- /table-card -->

      <!-- Pagination -->
      <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
          <li class="page-item disabled"><a class="page-link rounded-start-pill" href="#">«</a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item"><a class="page-link rounded-end-pill" href="#">»</a></li>
        </ul>
      </nav>

    </div>


    <%- include('../partials/footer') %>
    <script>
      let search = document.getElementById('SearchInput')
      
      search.addEventListener('input',(e)=>{
        const term = e.target.value.toLowerCase().trim()
         document.querySelectorAll('#resultBody tr').forEach(rows=>{
         const match = rows.dataset.search.toLowerCase().includes(term)
         rows.style.display = match ? '' : 'none'
         })
      })
     
     
    </script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
      <script src="/Bootstrap4/js/color-modes.js"></script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
</body>

</html>