<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Buyer – Ntec Seller</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <style>
    .color-success {
      background: rgba(208, 239, 160, 0.8);
    }

    :root {
      --brand: #7c3aed;
      --brand2: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #7c3aed, #4f46e5);
      color: #fff;
      padding: 40px 0;
    }

    /* Stat cards */
    .stat-card {
      background: #fff;
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-3px);
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    /* Table container */
    .table-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      overflow: hidden;
    }

    /* ============================================================
       RESPONSIVE TABLE — works down to 320px
       The table-responsive div adds overflow-x:auto only when needed.
       Column widths are controlled with white-space:nowrap to prevent
       text wrapping that would make rows taller and harder to scan.
    ============================================================ */
    .orders-table thead {
      background: #f8f8ff;
    }

    .orders-table th {
      font-size: .82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: #6b7280;
      padding: 14px 16px;
      white-space: nowrap;
      border-bottom: 2px solid #e5e7eb;
    }

    .orders-table td {
      padding: 14px 16px;
      vertical-align: middle;
      border-bottom: 1px solid #f3f4f6;
      white-space: nowrap;
    }

    .orders-table tr:last-child td {
      border-bottom: none;
    }

    .orders-table tbody tr:hover {
      background: #fafbff;
    }

    /* Status badges */
    .status-badge {
      padding: 4px 12px;
      border-radius: 50px;
      font-size: .76rem;
      font-weight: 600;
    }

    /* Search & filter bar */
    .filter-bar {
      background: #fff;
      border-radius: 14px;
      padding: 14px 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .form-control,
    .form-select {
      border-radius: 10px;
      border: 2px solid #e5e7eb;
      padding: 9px 14px;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(124, 58, 237, .08);
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-seller') %>

    <!-- PAGE HEADER -->
    <section class="page-header">
      <div class="container-xl">
        <h4 class="fw-bold mb-1">Orders</h4>
        <p class="mb-0 opacity-75">View and manage all customer orders for your store</p>
      </div>
    </section>

    <div class="container-xl py-4">

      <!-- STAT CARDS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="fa fa-receipt"></i></div>
            <div>
              <% function getcount(status){ const found=counts.find(c=> c.status === status)
                return found ? found.total : 0;
                }
                %>
                <div class="fw-bold fs-5">
                  <%= result3.total %>
                </div>
                <div class="small text-muted">All Orders</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#fef9c3;color:#854d0e;"><i class="fa fa-hourglass-half"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('pending') %>
              </div>
              <div class="small text-muted">Pending</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#dbeafe;color:#1e40af;"><i class="fa fa-truck"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('order confirm') %>
              </div>
              <div class="small text-muted">Order confirm</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card d-flex align-items-center gap-3 p-2 p-lg-3">
            <div class="stat-icon" style="background:#dcfce7;color:#166534;"><i class="fa fa-check"></i></div>
            <div>
              <div class="fw-bold fs-5">
                <%= getcount('delivered') %>
              </div>
              <div class="small text-muted">Delivered</div>
            </div>
          </div>
        </div>
      </div>

      <div class="container">
        <div class="d-flex justify-content-around align-items-center">
          <div class="text-center">
            <h4 style="color: #4f46e5;">Your Orders
            </h4>
          </div>
          <form action="" class="d-flex">
            <div class="input-group mb-3">
              <input type="text" name="se" id="SearchInput" placeholder="Search orders.." class="form-control">
            </div>
          </form>
        </div>

      </div>

     <!-- STATUS TABS -->
      <ul class="nav nav-pills gap-2 mb-4 flex-nowrap overflow-auto pb-1" style="scrollbar-width:none;">
        <li class="nav-item"><a class="nav-link filter-tab active rounded-pill" data-status="all" href="#">All (<span
              class="valuestatus">
              <%= result3.total %>
            </span>)</a></li>
        <li class="nav-item"><a class="nav-link filter-tab rounded-pill" data-status="pending" href="#">Pending (<span
              class="valuestatus">
              <%= getcount('pending') %>
            </span>)</a></li>
        <li class="nav-item"><a class="nav-link filter-tab rounded-pill" data-status="processing" href="#">Processing
            (<span class="valuestatus">
              <%= getcount('processing') %>
            </span>)</a>
        </li>
        <li class="nav-item"><a class="nav-link filter-tab rounded-pill" data-status="order confirm" href="#">Order
            confirm (<span class="valuestatus">
              <%= getcount('order confirm') %>
            </span>)</a>
        </li>
        <li class="nav-item"><a class="nav-link filter-tab rounded-pill" data-status="delivered" href="#">Delivered
            (<span class="valuestatus">
              <%= getcount('delivered') %>
            </span>)</a></li>
        <li class="nav-item"><a class="nav-link filter-tab rounded-pill" data-status="cancel" href="#">Cancelled (<span
              class="valuestatus">
              <%= getcount('cancel') %>
            </span>)</a></li>
      </ul>

      <!-- ORDERS TABLE — fully responsive, scrolls at any width down to 320px -->

      <div class="table-card">
        <div class="table-responsive">
          <div class=" justify-content-center align-items-center d-flex flex-column  fw-bold mt-5 d-none" id='me'>
            <img src="../images/order.png" height="160" width="160" class="img-fluid" alt="">
          </div>
          <% if(show.length===0){ %>
            <div class=" justify-content-center align-items-center d-flex flex-column  fw-bold mt-5 d-none">
              <img src="../images/order.png" height="160" width="160" class="img-fluid" alt="">
            </div>
            <% } else { %>
              <table class="table orders-table mb-0 " id="table">
                <thead>
                  <tr>
                    <th>Order Id</th>
                    <th>Seller Id</th>
                    <th>Buyer Id</th>
                    <th>Product Id</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Location</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Image</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="resultBody">
                  <% for(let i=0; i < show.length; i++){ %>
                    <tr class="text-center" data-status="<%= show[i].status %>"
                      data-search="<%= show[i].id %> <%= show[i].bid %> <%= show[i].pid %> <%= show[i].product %>">
                      <td>
                        <%= show[i].id %>
                      </td>
                      <td>
                        <%= show[i].sid %>
                      </td>
                      <td>
                        <%= show[i].bid %>
                      </td>
                      <td>
                        <%= show[i].pid %>
                      </td>
                      <td>
                        <%= show[i].product %>
                      </td>
                      <td>
                        <%= show[i].price %>
                      </td>
                      <td>
                        <%= show[i].qty %>
                      </td>
                      <td>
                        <%= show[i].shipping_address %>
                      </td>
                      <td>
                        <%= show[i].amount %>
                      </td>
                      <td class="text-capitalize">
                        <%= show[i].status %>
                      </td>
                      <td><img src="/products/<%= show[i].image %>" height="70" width="70" class="object-fit-cover"
                          alt=""></td>
                      <% if(show[i].status==='delivered' ){ %>
                        <td class=" text-center"><i class="fa fa-check fs-2 text-success"></i></td>
                        <% } else if(show[i].status==='cancel' ){ %>
                          <td class=" text-center"><i class="fa fa-close fs-2 text-danger"></i></td>
                          <% } else{ %>

                            <td>
                              <% if(show[i].status==='order confirm' ){ %>
                                <button class="btn btn-primary btn-sm " data-bs-toggle="modal"
                                  data-bs-target="#Mymodal<%= show[i].id %>"><i class="fa fa-pencil"></i></button>
                                <% } else if(show[i].status !=='delivered' && show[i].status !=='order confirm' ){ %>
                                  <button class="btn btn-danger btn-sm " data-bs-toggle="modal"
                                    data-bs-target="#cancelModal<%= show[i].id %>"><i class="fa fa-trash"></i></button>
                                  <button class="btn btn-primary btn-sm " data-bs-toggle="modal"
                                    data-bs-target="#Mymodal<%= show[i].id %>"><i class="fa fa-pencil"></i></button>
                                  <% } %>
                            </td>
                    </tr>
                    <div class="modal fade" id="Mymodal<%= show[i].id %>" tabindex="-1">
                      <div class="modal-dialog modal-sm">
                        <div class="modal-content rounded-4 border-0 shadow">
                          <div class="modal-header border-0">
                            <h5 class="modal-title fw-bold">Update Status</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body text-muted small">
                            <form action="/edit_status_order/<%= show[i].id %>" method="get">
                              <label for="" class="form-label">Status</label>
                              <select name="status" class="form-select" id="">

                                <option selected>
                                  <%= show[i].status %>
                                </option>
                                <% if(show[i].status==='order confirm' ){ %>
                                  <option value="delivered">Delivered</option>
                                  <% } else{ %>
                                    <option value="pending">Pending</option>
                                    <option value="processing">Processing</option>
                                    <option value="order confirm">Order Confirm</option>
                                    <option value="cancel">Cancel</option>
                                    <option value="delivered">Delivered</option>
                                    <% } %>
                              </select>

                          </div>
                          <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm"
                              data-bs-dismiss="modal">No</button>

                            <button type="submit" class="btn btn-danger rounded-pill btn-sm">Yes,
                              Change</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="modal fade" id="cancelModal<%= show[i].id %>" tabindex="-1">
                      <div class="modal-dialog modal-sm">
                        <div class="modal-content rounded-4 border-0 shadow">
                          <div class="modal-header border-0">
                            <form action="/delorder_order/<%= show[i].id %>" method="get">
                              <input type="hidden" name="bid" value="<%= show[i].bid %>">
                              <h5 class="modal-title fw-bold">Delete Order?</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body text-muted small">
                            Are you sure you want to Delete this order? This action cannot be undone and
                            the customer will be notified.
                          </div>
                          <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm"
                              data-bs-dismiss="modal">No, Keep
                              It</button>
                            <button type="submit" class="btn btn-danger rounded-pill btn-sm">Yes,
                              Delete</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                    <% }%>
                      <% }%>
                </tbody>
              </table>
              <% } %>
        </div><!-- /table-responsive -->
      </div><!-- /table-card -->

      <!-- Pagination -->
      <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
          <li class="page-item disabled"><a class="page-link rounded-start-pill" href="#">«</a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item"><a class="page-link rounded-end-pill" href="#">»</a></li>
        </ul>
      </nav>

    </div>


    <%- include('../partials/footer') %>
      <script>
        let table = document.getElementById('table')
        let message = document.getElementById('me')
        let search = document.getElementById('SearchInput')

        search.addEventListener('input', (e) => {
          const term = e.target.value.toLowerCase().trim()
          document.querySelectorAll('#resultBody tr').forEach(rows => {
            const match = rows.dataset.search.toLowerCase().includes(term)
            rows.style.display = match ? '' : 'none'
          })
        })
        document.querySelectorAll('.filter-tab').forEach(tab => {
          tab.addEventListener('click', (e) => {
            e.preventDefault()
            const status = tab.dataset.status
            let show = 0
            // active pill
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'))
            tab.classList.add('active')

            // filter rows
            document.querySelectorAll('#resultBody tr').forEach(row => {
              if (status === 'all' || row.dataset.status === status) {
                row.style.display = ''
                show++
              }
              else {
                row.style.display = 'none'
              }
            })
            if (show === 0) {
              table.style.display = 'none'
              message.classList.remove('d-none')
            }
            else {
              table.style.display = ''
              message.classList.add('d-none')
            }

          })
        })
      </script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
      <script src="/Bootstrap4/js/color-modes.js"></script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
</body>

</html>