<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= product.product %> – Overview | Ntec Seller
  </title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/chart.js"></script>
  <style>
    .chart-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      padding: 24px;
      overflow: hidden;
      /* Add this to prevent overflow */
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --brand: #7c3aed;
      --brand2: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #7c3aed, #4f46e5);
      color: #fff;
      padding: 40px 0;
    }

    .back-btn {
      color: rgba(255, 255, 255, 0.8);
      font-size: .9rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 12px;
      transition: color .2s;
    }

    .back-btn:hover {
      color: #fff;
    }

    /* Stat cards */
    .stat-card {
      background: #fff;
      border-radius: 16px;
      padding: 25px 7px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    .stat-label {
      font-size: .68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: #6b7280;
      margin-bottom: 2px;
    }

    .stat-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: #111827;
      line-height: 1;
    }

    /* Product info card */
    .product-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      overflow: hidden;
    }

    .product-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-info {
      padding: 20px 24px;
    }

    .product-name {
      font-size: 1.2rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 4px;
    }

    .product-category {
      display: inline-block;
      background: #ede9fe;
      color: var(--brand);
      font-size: .75rem;
      font-weight: 600;
      padding: 3px 12px;
      border-radius: 50px;
      margin-bottom: 14px;
    }

    .product-meta {
      font-size: .9rem;
      color: #6b7280;
      margin-bottom: 6px;
    }

    .product-meta span {
      color: #111827;
      font-weight: 600;
    }

    /* Stock badge */
    .stock-ok {
      background: #d1fae5;
      color: #065f46;
    }

    .stock-low {
      background: #fef3c7;
      color: #92400e;
    }

    .stock-out {
      background: #fee2e2;
      color: #991b1b;
    }

    /* Chart card */
    .chart-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      padding: 24px;
    }

    .chart-title {
      font-size: .95rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-title i {
      color: var(--brand);
    }

    /* Stock indicator bar */
    .stock-bar-wrap {
      background: #f3f4f6;
      border-radius: 50px;
      height: 10px;
      overflow: hidden;
      margin: 10px 0 6px;
    }

    .stock-bar-fill {
      height: 100%;
      border-radius: 50px;
      transition: width .6s ease;
    }

    /* Alert box */
    .alert-low {
      background: #fef3c7;
      border-left: 4px solid #f59e0b;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: .88rem;
      color: #92400e;
      margin-top: 14px;
    }

    .alert-ok {
      background: #d1fae5;
      border-left: 4px solid #10b981;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: .88rem;
      color: #065f46;
      margin-top: 14px;
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-seller') %>

    <!-- PAGE HEADER -->
    <section class="page-header">
      <div class="container-xl">
        <a href="/seller/products" class="back-btn">
          <i class="fa fa-arrow-left"></i> Back to Products
        </a>
        <h4 class="fw-bold mb-1">
          <%= product.product %>
        </h4>
        <p class="mb-0 opacity-75">Product performance overview</p>
      </div>
    </section>

    <div class="container-xl py-4">

      <!-- STAT CARDS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-icon" style="background:#ede9fe;">
              <i class="fa fa-shopping-bag" style="color:#7c3aed;"></i>
            </div>
            <div class="d-flex flex-column">
              <div class="stat-value">
                <%= sold[0].total %>
              </div>
              <div class="stat-label">Total Sold</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-icon" style="background:#d1fae5;">
              <i class="fa fa-dollar-sign" style="color:#059669;"></i>
            </div>
            <div class="d-flex flex-column ">
              <div class="stat-value">$<%= revenue[0].total %>
              </div>
              <div class="stat-label">Revenue</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7;">
              <i class="fa fa-clock" style="color:#d97706;"></i>
            </div>
            <div class="d-flex flex-column">
              <div class="stat-value">
                <%= statusBreakdown.find(s=> s.status === 'pending')?.total || 0 %>
              </div>
              <div class="stat-label">Pending</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;">
              <i class="fa fa-boxes" style="color:#0284c7;"></i>
            </div>
            <div class="d-flex flex-column">
              <div class="stat-value">
                <%= product.stock %>
              </div>
              <div class="stat-label">In Stock</div>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-4">

        <!-- LEFT: Product Info + Stock -->
        <div class="col-lg-4">
          <div class="product-card">
            <img src="/products/<%= product.image %>" alt="<%= product.product %>" class="product-img">
            <div class="product-info">
              <div class="product-name">
                <%= product.product %>
              </div>
              <span class="product-category">
                <%= product.category %>
              </span>
              <div class="product-meta">Price: <span>$<%= product.price %></span></div>
              <div class="product-meta">Description: <span>
                  <%= product.description || 'N/A' %>
                </span></div>

              <!-- Stock bar -->
              <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center">
                  <span style="font-size:.82rem; font-weight:600; color:#6b7280;">STOCK LEVEL</span>
                  <span style="font-size:.82rem; font-weight:700; color:#111827;">
                    <%= product.stock %> units
                  </span>
                </div>
                <% const maxStock=100; const pct=Math.min((product.stock / maxStock) * 100, 100); const
                  barColor=product.stock <=5 ? '#ef4444' : product.stock <=15 ? '#f59e0b' : '#10b981' ; %>
                  <div class="stock-bar-wrap">
                    <div class="stock-bar-fill" style="width:<%= pct %>%; background:<%= barColor %>;"></div>
                  </div>
                  <% if(product.stock===0){ %>
                    <div class="alert-low"><i class="fa fa-times-circle me-1"></i> Out of stock — restock immediately.
                    </div>
                    <% } else if(product.stock <=5){ %>
                      <div class="alert-low"><i class="fa fa-exclamation-triangle me-1"></i> Low stock — only <%=
                          product.stock %> units left.</div>
                      <% } else { %>
                        <div class="alert-ok"><i class="fa fa-check-circle me-1"></i> Stock level looks good.</div>
                        <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Charts -->
        <div class="col-lg-8">

          <!-- Orders Graph -->
          <div class="chart-card mb-4">
            <div class="container">
              <div class="row">
                <div class="col-12">

                </div>
              </div>
            </div>
            <div class="chart-title">

              <i class="fa fa-chart-line"></i> Orders Over Time
            </div>
            <div style="position: relative; height: 220px;">
              <canvas id="ordersChart"></canvas>
            </div>
          </div>

          <!-- Status Breakdown -->
          <div class="chart-card">
            <div class="chart-title">
              <i class="fa fa-chart-pie"></i> Order Status Breakdown
            </div>
              <% if(sold[0].total === 0) { %>
              <h2 class="text-center text-muted mt-5">You have 0 sold</h2>
            <%  } else{ %>
              <canvas id="statusChart" height="100"></canvas>
          <%  } %>
          </div>

        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>

      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
      <script>

   


        const orderDates = <%- JSON.stringify(orderGraph.map(r => r.date)) %>;
        const orderCounts = <%- JSON.stringify(orderGraph.map(r => r.total)) %>;

        new Chart(document.getElementById('ordersChart'), {
          type: 'line',
          data: {
            labels: orderDates,
            datasets: [{
              label: 'Orders',
              data: orderCounts,
              borderColor: '#7c3aed',
              backgroundColor: 'rgba(124,58,237,0.08)',
              borderWidth: 2.5,
              pointBackgroundColor: '#7c3aed',
              pointRadius: 4,
              tension: 0.4,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
              padding: {
                left: 10,   // Add left padding
                right: 20,  // Add right padding
                top: 5,
                bottom: 5
              }
            },
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  precision: 0,
                  padding: 10  // Add padding to y-axis ticks
                },
                grid: { color: '#f3f4f6' }
              },
              x: {
                grid: { display: false },
                ticks: {
                  padding: 10,           // Add padding to x-axis ticks
                  maxRotation: 45,       // Allow rotation if needed
                  minRotation: 0,
                  callback: function (value, index, values) {
                    const label = this.getLabelForValue(value);
                    const parts = label.split('-');
                    if (parts.length === 3) {
                      return parts[1] + '/' + parts[2]; 
                    }
                    return label;
                  }
                }
              }
            }
          }
        });
         const statusLabels = <%- JSON.stringify(statusBreakdown.map(s => s.status)) %>;
    const statusData = <%- JSON.stringify(statusBreakdown.map(s => s.total)) %>;

    new Chart(document.getElementById('statusChart'), {
      type: 'doughnut',
      data: {
        labels: statusLabels,
        datasets: [{
          data: statusData,
          backgroundColor: ['#fbbf24', '#10b981', '#ef4444'],
          borderWidth: 0,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        cutout: '65%',
        plugins: {
          legend: { position: 'bottom', labels: { padding: 16, font: { size: 13 } } }
        }
      }
    });
      </script>
</body>

</html>