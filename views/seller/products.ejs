<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Products – Ntec Seller</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <style>
    :root {
      --brand: #7c3aed;
      --brand2: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #7c3aed, #4f46e5);
      color: #fff;
      padding: 40px 0;
    }

    /* Filter bar */
    .filter-bar {
      background: #fff;
      border-radius: 14px;
      padding: 14px 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .form-control,
    .form-select {
      border-radius: 10px;
      border: 2px solid #e5e7eb;
      padding: 9px 14px;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(124, 58, 237, .08);
    }

    /* ============================================================
       RESPONSIVE TABLE — scrollable down to 320px
       All th/td use white-space:nowrap so the table scrolls
       horizontally rather than squishing content.
    ============================================================ */
    .table-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      overflow: hidden;
    }

    .products-table thead {
      background: #f8f8ff;
    }

    .products-table th {
      font-size: .82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: #6b7280;
      padding: 14px 16px;
      white-space: nowrap;
      border-bottom: 2px solid #e5e7eb;
    }

    .products-table td {
      padding: 14px 16px;
      vertical-align: middle;
      border-bottom: 1px solid #f3f4f6;
      white-space: nowrap;
    }

    .products-table tr:last-child td {
      border-bottom: none;
    }

    .products-table tbody tr:hover {
      background: #fafbff;
    }

    /* Stock badge */
    .stock-badge {
      padding: 4px 12px;
      border-radius: 50px;
      font-size: .76rem;
      font-weight: 600;
    }

    /* Action buttons in table */
    .btn-action {
      padding: 5px 14px;
      border-radius: 50px;
      font-size: .82rem;
      font-weight: 500;
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-seller') %>

    <!-- PAGE HEADER -->
    <section class="page-header">
      <div class="container-xl d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h4 class="fw-bold mb-1">My Products</h4>
          <p class="mb-0 opacity-75">Manage your product listings, stock, and pricing</p>
        </div>
        <!-- Add Product triggers Bootstrap modal -->
        <button class="btn btn-light text-primary fw-semibold rounded-pill px-4" data-bs-toggle="modal"
          data-bs-target="#addProductModal">
          <i class="fa fa-plus-circle me-1"></i> Add Product
        </button>
      </div>
    </section>

    <div class="container-xl py-4">
      <form>
        <input type="text" placeholder="Search products" class="form-control" id="SearchInput">
      </form>



      <div class="table-card mt-5">
        <div class="table-responsive">
          <% if(result.length===0){ %>
            <div class=" justify-content-center align-items-center d-flex flex-column  fw-bold mt-5 d-none">
              <img src="../images/product.png" height="160" width="160" class="img-fluid" alt="">
            </div>
            <% } else{ %>

              <table class="table products-table mb-0">
                <thead>
                  <tr>

                    <th>Id</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Overview</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="resultBody">
                  <% for(let i=0; i < result.length; i++){ %>
                    <tr data-search="<%= result[i].product %> <%= result[i].id %> <%= result[i].category %>">
                      <td>
                        <%= result[i].id %>
                      </td>
                      <td>
                        <img src="/products/<%= result[i].image %>" width="50" height="50" class="object-fit-cover"
                          alt="">
                        <%= result[i].product %>
                      </td>
                      <td>
                        <%= result[i].category %>
                      </td>
                      <td>
                        <span>$</span>
                        <%= result[i].price %>
                      </td>
                      <td>
                        <%= result[i].stock %>
                      </td>
                      <td>
                        <a href="/product_overview/<%= result[i].id %>" class="btn btn-primary">Overview</a>
                      </td>
                      <td>
                        <div class="row">
                          <div class="col-6 col-md-3">
                            <form action="/delproduct/<%= result[i].id %>" method="post">

                              <button type="submit" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></button>
                            </form>
                          </div>
                          <div class="col-6 col-md-3">
                            <button data-bs-toggle="modal" data-bs-target="#update<%= result[i].id %>"
                              class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i></button>
                          </div>
                        </div>
                        <div class="modal fade" id="update<%= result[i].id%>" tabindex="-1">
                          <div class="modal-dialog modal-lg">
                            <div class="modal-content rounded-4 border-0 shadow">
                              <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">Edit Product</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                              </div>
                              <div class="modal-body">
                                <!-- NOTE: action to include product ID — backend fills values via EJS -->
                                <form action="/update_products/<%= result[i].id%>" method="POST"
                                  enctype="multipart/form-data">
                                  <div class="row g-3">
                                    <div class="col-12">
                                      <label class="form-label fw-medium">Product Name</label>
                                      <input type="text" name="name" class="form-control"
                                        value="<%= result[i].product%>" required>
                                    </div>
                                    <div class="col-sm-6">
                                      <label class="form-label fw-medium">Category</label>
                                      <select name="category" class="form-select">
                                        <option selected>
                                          <%= result[i].category%>
                                        </option>
                                        <option>Earbuds</option>
                                        <option>VR Headsets</option>
                                        <option>Speakers</option>
                                        <option>Wearables</option>
                                      </select>
                                    </div>

                                    <div class="col-sm-6">
                                      <label class="form-label fw-medium">Price ($)</label>
                                      <input type="number" name="price" class="form-control"
                                        value="<%= result[i].price%>" step="0.01">
                                    </div>
                                    <div class="col-sm-6">
                                      <label class="form-label fw-medium">Stock Quantity</label>
                                      <input type="number" name="stock" class="form-control"
                                        value="<%= result[i].stock%>">
                                    </div>
                                    <div class="col-12">
                                      <label class="form-label fw-medium">Description</label>
                                      <textarea name="description" class="form-control"
                                        rows="3"><%= result[i].description%></textarea>
                                    </div>
                                    <div class="col-12">
                                      <label class="form-label fw-medium">Replace Image <span
                                          class="text-muted small">(optional)</span></label>
                                      <input type="file" name="image" class="form-control" accept="image/*">
                                    </div>

                                  </div>
                                  <div class="d-flex gap-2 justify-content-end mt-4">
                                    <button type="button" class="btn btn-outline-secondary rounded-pill"
                                      data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save
                                      Changes</button>
                                  </div>
                                </form>
                              </div>
                            </div>
                          </div>
                        </div>

                      </td>
                    </tr>
                    <% } %>

                </tbody>
              </table>
              <%} %>
        </div><!-- /table-responsive -->

        <!-- Bulk actions bar (shown when rows selected — Bootstrap collapse) -->
        <div class="border-top px-4 py-2 d-flex align-items-center gap-3">
          <span class="small text-muted">Bulk actions:</span>
          <button class="btn btn-sm btn-outline-danger rounded-pill">Delete Selected</button>
          <button class="btn btn-sm btn-outline-secondary rounded-pill">Export Selected</button>
        </div>

      </div><!-- /table-card -->

      <!-- Pagination -->
      <nav class="mt-4 d-flex justify-content-center">
        <ul class="pagination">
          <li class="page-item disabled"><a class="page-link rounded-start-pill" href="#">«</a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link rounded-end-pill" href="#">»</a></li>
        </ul>
      </nav>

    </div>

    <!-- ============================================================
     ADD PRODUCT MODAL
============================================================ -->
    <div class="modal fade" id="addProductModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-header border-0">
            <h5 class="modal-title fw-bold">Add New Product</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <!-- NOTE: action/method to be wired by backend (multer for image upload) -->
            <form action="/insert_product" method="POST" enctype="multipart/form-data">
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label fw-medium">Product Name</label>
                  <input type="text" name="name" class="form-control" placeholder="e.g. Sequoia Pro X" required>
                </div>
                <div class="col-sm-6">
                  <label class="form-label fw-medium">Category</label>
                  <select name="category" class="form-select" required>
                    <option value="">Select…</option>
                    <option>Headphones</option>
                    <option>Earbuds</option>
                    <option>VR Headsets</option>
                    <option>Speakers</option>
                    <option>Wearables</option>
                  </select>
                </div>

                <div class="col-sm-6">
                  <label class="form-label fw-medium">Price ($)</label>
                  <input type="number" name="price" class="form-control" placeholder="0.00" step="0.01" required>
                </div>
                <div class="col-sm-6">
                  <label class="form-label fw-medium">Stock Quantity</label>
                  <input type="number" name="stock" class="form-control" placeholder="0" required>
                </div>
                <div class="col-12">
                  <label class="form-label fw-medium">Description</label>
                  <textarea name="description" class="form-control" rows="3"
                    placeholder="Describe your product…"></textarea>
                </div>
                <!-- Product image upload — backend uses multer to handle -->
                <div class="col-12">
                  <label class="form-label fw-medium">Product Image</label>
                  <input type="file" name="image" class="form-control" accept="image/*">
                  <div class="form-text">Recommended: 800×800px, PNG or JPG, max 2MB</div>
                </div>

              </div>
              <!-- Submit inside form — Bootstrap modal footer buttons submit this form -->
              <div class="d-flex gap-2 justify-content-end mt-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill"
                  data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Add Product</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
     EDIT PRODUCT MODAL (same structure, pre-filled by backend)
============================================================ -->

    <!-- DELETE CONFIRMATION MODAL -->
    <div class="modal fade" id="deleteProductModal" tabindex="-1">
      <div class="modal-dialog modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-header border-0">
            <h5 class="modal-title fw-bold">Delete Product?</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-muted small">
            This will permanently remove the product from your store. All related data will be lost.
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm"
              data-bs-dismiss="modal">Cancel</button>
            <!-- Backend: action="/seller/products/:id/delete" method="POST" -->
            <button type="button" class="btn btn-danger rounded-pill btn-sm" data-bs-dismiss="modal">Delete</button>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>
      <script>
        let search = document.getElementById('SearchInput')

        search.addEventListener('input', (e) => {
          const term = e.target.value.toLowerCase().trim()
          document.querySelectorAll('#resultBody tr').forEach(rows => {
            const match = rows.dataset.search.toLowerCase().includes(term)
            rows.style.display = match ? '' : 'none'
          })
        })
      </script>
      <script src="/Bootstrap4/js/color-modes.js"></script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>

</html>