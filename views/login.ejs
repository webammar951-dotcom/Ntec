<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – Ntec</title>
      <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"> -->
  <style>
    :root { --brand: #4f46e5; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #eef2ff 0%, #e0f2fe 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    h1,h2,h3,h4 { font-family: 'Syne', sans-serif; }
    .auth-card {
      background: #fff;
      border-radius: 28px;
      padding: 48px 40px;
      box-shadow: 0 20px 60px rgba(79,70,229,.12);
      width: 100%;
      max-width: 440px;
    }
    .form-control {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 12px 16px;
      transition: border-color .2s;
    }
    .form-control:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79,70,229,.08);
    }
    .input-group .form-control { border-right: none; border-radius: 12px 0 0 12px; }
    .input-group .btn { border: 2px solid #e5e7eb; border-left: none; border-radius: 0 12px 12px 0; background: #fff; color: #9ca3af; }
    .input-group .btn:hover { color: var(--brand); }
    .btn-primary {
      border-radius: 50px;
      padding: 14px;
      font-weight: 600;
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      width: 100%;
      font-size: 1rem;
    }
    .btn-primary:hover { opacity: .88; background: linear-gradient(90deg, #4f46e5, #7c3aed); }
    .divider { position: relative; text-align: center; margin: 24px 0; }
    .divider::before {
      content: ''; position: absolute; top: 50%; left: 0; right: 0;
      height: 1px; background: #e5e7eb;
    }
    .divider span {
      background: #fff; position: relative;
      padding: 0 12px; color: #9ca3af; font-size: .85rem;
    }
    .social-btn {
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 10px;
      background: #fff;
      width: 100%;
      font-weight: 500;
      color: #374151;
      transition: border-color .2s;
    }
    .social-btn:hover { border-color: var(--brand); color: var(--brand); }
    .role-tab { cursor: pointer; }
    .role-tab.active {
      background: var(--brand);
      color: #fff;
      border-radius: 10px;
    }
  </style>
</head>
<body>

<div class="auth-card">

  <!-- Brand -->
  <div class="text-center mb-4">
    <a href="/index" class="fw-bold fs-3 text-decoration-none" style="color:var(--brand); font-family:'Syne',sans-serif;">
      Ntec.
    </a>
    <p class="text-muted mt-1 mb-0 small">Welcome back! Sign in to continue.</p>
  </div>

  <!-- Role Selector (Buyer / Seller) — no JS, just Bootstrap tabs -->


  <!-- Tab content — Bootstrap tabs handle switching, no custom JS needed -->
  <div class="tab-content">

    <!-- BUYER LOGIN -->
    <div class="tab-pane fade show active" id="buyerTab">
      <!-- NOTE: action/method to be wired by backend -->
      <form action="/loginjs" method="POST">
        <div class="mb-3">
          <label class="form-label fw-medium">Email</label>
          <input type="email" name="email" class="form-control" placeholder="ahmad@email.com" required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-medium d-flex justify-content-between">
            Password
            <a href="#" class="text-decoration-none small" style="color:var(--brand);">Forgot?</a>
          </label>
          <!-- Password with show/hide toggle using Bootstrap only -->
          <div class="input-group">
            <input type="password" name="password" class="form-control" placeholder="Enter password" id="buyerPass" required>
            <button type="button" class="btn" data-bs-toggle="collapse" data-bs-target="#dummy"
                    onclick="var i=document.getElementById('buyerPass'); i.type=i.type==='password'?'text':'password';">
              <i class="fa fa-eye"></i>
            </button>
          </div>
        </div>
        <div class="form-check mb-4">
          <input type="checkbox" class="form-check-input" id="rememberBuyer">
          <label class="form-check-label small" for="rememberBuyer">Remember me</label>
        </div>
                  <div class="col-12 mt-3">
            <div class="alert text-danger">
              <%= message !==null ? message : '' %>
            </div>
          </div>
        <button type="submit" class="btn btn-primary">Login</button>
      </form>
    </div>

  
    

  </div>

  <div class="divider"><span>or continue with</span></div>

  <!-- Social login buttons (UI only — backend to implement OAuth) -->
  <div class="row g-2">
    <div class="col-6">
      <button class="social-btn">
        <img src="https://www.svgrepo.com/show/355037/google.svg" width="18" class="me-2" alt="Google">
        Google
      </button>
    </div>
    <div class="col-6">
      <button class="social-btn">
        <i class="bi bi-facebook me-2" style="color:#1877f2;"></i>
        Facebook
      </button>
    </div>
  </div>

  <p class="text-center small text-muted mt-4 mb-0">
    Don't have an account?
    <a href="/signup" class="fw-semibold text-decoration-none" style="color:var(--brand);">Sign Up</a>
  </p>

</div>
<script src="/Bootstrap4/js/color-modes.js"></script>
<script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
<script>AOS.init({ duration: 700, once: true });</script>
<!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>
</html>
