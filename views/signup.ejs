<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up – Ntec</title>
      <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/bootstrap.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"> -->
  <style>
    :root { --brand: #4f46e5; }
    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #eef2ff 0%, #e0f2fe 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    h1,h2,h3,h4 { font-family: 'Syne', sans-serif; }
    .auth-card {
      background: #fff;
      border-radius: 28px;
      padding: 44px 40px;
      box-shadow: 0 20px 60px rgba(79,70,229,.12);
      width: 100%;
      max-width: 480px;
    }
    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 11px 16px;
      transition: border-color .2s;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79,70,229,.08);
    }
    .input-group .form-control { border-right: none; border-radius: 12px 0 0 12px; }
    .input-group .btn { border: 2px solid #e5e7eb; border-left: none; border-radius: 0 12px 12px 0; background: #fff; color: #9ca3af; }
    .input-group .btn:hover { color: var(--brand); }
    .btn-primary {
      border-radius: 50px;
      padding: 14px;
      font-weight: 600;
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      width: 100%;
      font-size: 1rem;
    }
    .btn-primary:hover { opacity: .88; background: linear-gradient(90deg, #4f46e5, #7c3aed); }
    .role-tab { cursor: pointer; transition: background .15s; }
    .role-tab.active { background: var(--brand); color: #fff; border-radius: 10px; }
  </style>
</head>
<body>

<div class="auth-card">

  <!-- Brand -->
  <div class="text-center mb-4">
    <a href="/index" class="fw-bold fs-3 text-decoration-none" style="color:var(--brand); font-family:'Syne',sans-serif;">Ntec.</a>
    <p class="text-muted mt-1 mb-0 small">Create your account and start shopping.</p>
  </div>

  <!-- Role selector -->


 
    <!-- BUYER SIGNUP -->
    <div class="tab-pane fade show active" id="buyerSignup">
      <!-- NOTE: action/method to be wired by backend -->
      <form action="/register" method="POST">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label fw-medium">Name</label>
            <input type="text" name="username" class="form-control" placeholder="Ahmad" required>
          </div>
        
          <div class="col-12">
            <label class="form-label fw-medium">Email</label>
            <input type="email" name="email" class="form-control" placeholder="ahmad@email.com" required>
          </div>
         <div class="col-12">
            <label class="form-label fw-medium">Fathername</label>
            <input type="text" name="fathername" class="form-control" placeholder="Fathername" required>
          </div>
          <div class="col-12">
            <label class="form-label fw-medium">Password</label>
            <div class="input-group">
              <input type="password" name="password" class="form-control" placeholder="Min. 8 characters" id="buyerPw" required>
              <button type="button" class="btn"
                      onclick="var i=document.getElementById('buyerPw'); i.type=i.type==='password'?'text':'password';">
                <i class="fa fa-eye"></i>
              </button>
            </div>
          </div>
       <div class="col-12">
            <label class="form-label fw-medium">Role</label>
            <select name="role" id="" class="form-select">
              <option value="buyer">Buyer</option>
              <option value="seller">Seller</option>
            </select>

          </div>
          <div class="col-12">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="termsB" required>
              <label class="form-check-label small" for="termsB">
                I agree to the <a href="#" style="color:var(--brand);">Terms &amp; Privacy Policy</a>
              </label>
            </div>
          </div>
          <div class="col-12 mt-3">
            <div class="alert text-danger">
              <%= message %>
            </div>
          </div>
          <div class="col-12 mt-1">
            <button type="submit" class="btn btn-primary">Create Account</button>
          </div>
           <p class="text-center small text-muted mt-4 mb-0">
    Already have an account?
    <a href="/login" class="fw-semibold text-decoration-none" style="color:var(--brand);">Sign In</a>
  </p>
        </div>
      </form>
    </div>
    </div>

    <!-- SELLER SIGNUP -->
    
    

 

</div>
<script src="/Bootstrap4/js/color-modes.js"></script>
<script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
<script>AOS.init({ duration: 700, once: true });</script>
<!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>
</html>
