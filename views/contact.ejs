<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact – Ntec</title>
      <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"> -->
  <style>
    :root { --brand: #4f46e5; --surface: #f4f4f8; }
    body { font-family: 'Inter', sans-serif; background: var(--surface); }
    h1,h2,h3 { font-family: 'Syne', sans-serif; }

    .page-hero {
      background: linear-gradient(135deg, #eef2ff 0%, #e0f2fe 100%);
      padding: 90px 0 70px;
    }
    .contact-card {
      background: #fff;
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 8px 40px rgba(0,0,0,.08);
    }
    .info-box {
      background: #fff;
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 4px 16px rgba(0,0,0,.06);
    }
    .info-icon {
      width: 48px; height: 48px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    /* Style Bootstrap form controls to match the clean design */
    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 12px 16px;
      transition: border-color .2s;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79,70,229,.1);
    }
    .btn-submit {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      border-radius: 50px;
      padding: 14px 48px;
      font-weight: 600;
      color: #fff;
      width: 100%;
      transition: opacity .2s;
    }
    .btn-submit:hover { opacity: .88; }
  </style>
</head>
<body>

<%- include('partials/navbar-simple') %>

<!-- PAGE HERO -->
<section class="page-hero text-center">
  <div class="container">
    <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill">Say Hello</span>
    <h1 class="fw-bold mb-3" style="font-size:clamp(2rem,4vw,3rem);">
      We'd Love to <span style="color:var(--brand);">Hear From You</span>
    </h1>
    <p class="text-muted fs-5 mx-auto" style="max-width:500px;">
      Have a question, issue, or just want to chat? Drop us a message and we'll get back within 24 hours.
    </p>
  </div>
</section>

<!-- CONTACT CONTENT -->
<section class="py-5">
  <div class="container-xl">
    <div class="row g-5 align-items-start">

      <!-- LEFT: Contact Form -->
      <div class="col-lg-7">
        <div class="contact-card">
          <h4 class="fw-bold mb-1">Send a Message</h4>
          <p class="text-muted mb-4">Fill out the form and we'll respond shortly.</p>

          <!-- NOTE: Form action/method to be connected by backend -->
          <form action="/contactjs" method="POST">
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label fw-medium">First Name</label>
                <input type="text" name="firstName" class="form-control" placeholder="Ahmad" required>
              </div>
              <div class="col-sm-6">
                <label class="form-label fw-medium">Last Name</label>
                <input type="text" name="lastName" class="form-control" placeholder="Khan" required>
              </div>
              <div class="col-12">
                <label class="form-label fw-medium">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="ahmad@email.com" required>
              </div>
              <div class="col-12">
                <label class="form-label fw-medium">Subject</label>
                <select name="subject" class="form-select">
                  <option value="">Select a topic…</option>
                  <option>Order Issue</option>
                  <option>Product Question</option>
                  <option>Return / Refund</option>
                  <option>Seller Inquiry</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label fw-medium">Message</label>
                <textarea name="message" class="form-control" rows="5" placeholder="Write your message here…" required></textarea>
              </div>
              <div class="col-12 mt-2">
                <button type="submit" class="btn-submit">
                  Send Message <i class="bi bi-send ms-2"></i>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- RIGHT: Contact Info -->
      <div class="col-lg-5">
        <h4 class="fw-bold mb-4">Contact Information</h4>
        <div class="d-flex flex-column gap-3">

          <div class="info-box d-flex align-items-center gap-3">
            <div class="info-icon" style="background:#eef2ff; color:#4f46e5;">
              <i class="bi bi-geo-alt"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0">Our Office</p>
              <p class="text-muted mb-0 small">Plot 42, Shaheed-e-Millat Rd, Karachi</p>
            </div>
          </div>

          <div class="info-box d-flex align-items-center gap-3">
            <div class="info-icon" style="background:#f0fdf4; color:#10b981;">
              <i class="bi bi-telephone"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0">Phone</p>
              <p class="text-muted mb-0 small">+92 300 1234567</p>
            </div>
          </div>

          <div class="info-box d-flex align-items-center gap-3">
            <div class="info-icon" style="background:#fff7ed; color:#f59e0b;">
              <i class="bi bi-envelope"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0">Email</p>
              <p class="text-muted mb-0 small">support@ntec.store</p>
            </div>
          </div>

          <div class="info-box d-flex align-items-center gap-3">
            <div class="info-icon" style="background:#fdf4ff; color:#7c3aed;">
              <i class="bi bi-clock"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0">Support Hours</p>
              <p class="text-muted mb-0 small">Mon–Sat: 9am – 8pm PKT</p>
            </div>
          </div>

        </div>

        <!-- Social links -->
        <div class="mt-4">
          <p class="fw-semibold mb-3">Follow Us</p>
          <div class="d-flex gap-2">
            <a href="#" class="btn btn-outline-secondary rounded-circle p-2"><i class="bi bi-twitter-x"></i></a>
            <a href="#" class="btn btn-outline-secondary rounded-circle p-2"><i class="bi bi-instagram"></i></a>
            <a href="#" class="btn btn-outline-secondary rounded-circle p-2"><i class="bi bi-facebook"></i></a>
            <a href="#" class="btn btn-outline-secondary rounded-circle p-2"><i class="bi bi-linkedin"></i></a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- FAQ ACCORDION — no JS needed, Bootstrap handles it -->
<section class="py-5" style="background:#fff;">
  <div class="container" style="max-width:720px;">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Frequently Asked Questions</h2>
      <p class="text-muted">Quick answers to common questions</p>
    </div>
    <div class="accordion rounded-4 overflow-hidden shadow-sm" id="faqAccordion">
      <div class="accordion-item border-0 border-bottom">
        <h2 class="accordion-header">
          <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
            How long does delivery take?
          </button>
        </h2>
        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted">Standard delivery takes 3–5 business days across Pakistan. Express options are available at checkout.</div>
        </div>
      </div>
      <div class="accordion-item border-0 border-bottom">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
            What is your return policy?
          </button>
        </h2>
        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted">We offer a 30-day no-questions-asked return policy for all products in original condition.</div>
        </div>
      </div>
      <div class="accordion-item border-0 border-bottom">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
            Can I track my order?
          </button>
        </h2>
        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted">Yes! Once shipped, you'll receive a tracking number via email. You can also track your order in the orders section of your account.</div>
        </div>
      </div>
      <div class="accordion-item border-0">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
            How do I become a seller?
          </button>
        </h2>
        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted">Sign up with a seller account and submit your store details. Our team will verify and approve within 48 hours.</div>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="/Bootstrap4/js/color-modes.js"></script>
<script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
<script>AOS.init({ duration: 700, once: true });</script>
<%- include('partials/footer') %>
<!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>
</html>
