<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact – Ntec</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script> 

  <style>
    :root {
      --brand: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      color: #fff;
      padding: 40px 0;
    }

    .contact-card {
      background: #fff;
      border-radius: 24px;
      padding: 36px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, .07);
    }

    .info-box {
      background: #fff;
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
    }

    .info-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .form-control,
    .form-select {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 11px 16px;
      transition: border-color .2s;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, .08);
    }

    .btn-submit {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      border-radius: 50px;
      padding: 13px 44px;
      font-weight: 600;
      color: #fff;
      width: 100%;
    }

    .btn-submit:hover {
      opacity: .88;
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-user') %>

    <section class="page-header">
      <div class="container-xl">
        <h4 class="fw-bold mb-1">Contact Support</h4>
        <p class="mb-0 opacity-75">Need help? We're here for you 24/7.</p>
      </div>
    </section>

    <div class="container-xl py-5">
      <div class="row g-5 align-items-start">

        <!-- LEFT: Contact Form -->
        <div class="col-lg-7">
          <div class="contact-card">
            <h5 class="fw-bold mb-1">Send a Message</h5>
            <p class="text-muted mb-4 small">Our support team replies within a few hours.</p>
            <!-- NOTE: action/method to be wired by backend -->
            <form action="/user/contact" method="POST">
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label fw-medium">Subject</label>
                  <select name="subject" class="form-select">
                    <option value="">Select a topic…</option>
                    <option>Order Issue</option>
                    <option>Payment Problem</option>
                    <option>Product Query</option>
                    <option>Return / Refund</option>
                    <option>Technical Issue</option>
                    <option>Other</option>
                  </select>
                </div>
                <!-- Pre-fill order ID if coming from orders page — backend can inject value -->
                <div class="col-12">
                  <label class="form-label fw-medium">Related Order ID <span
                      class="text-muted small">(optional)</span></label>
                  <input type="text" name="orderId" class="form-control" placeholder="#NTC-001">
                </div>
                <div class="col-12">
                  <label class="form-label fw-medium">Message</label>
                  <textarea name="message" class="form-control" rows="5" placeholder="Describe your issue in detail…"
                    required></textarea>
                </div>
                <!-- File attachment — UI only, backend handles multer -->
                <div class="col-12">
                  <label class="form-label fw-medium">Attach Screenshot <span
                      class="text-muted small">(optional)</span></label>
                  <input type="file" name="attachment" class="form-control" accept="image/*,.pdf">
                </div>
                <div class="col-12 mt-1">
                  <button type="submit" class="btn-submit">Submit Ticket <i class="bi bi-send ms-2"></i></button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- RIGHT: Info + Quick Links -->
        <div class="col-lg-5">
          <h5 class="fw-bold mb-3">Other Ways to Reach Us</h5>
          <div class="d-flex flex-column gap-3 mb-4">
            <div class="info-box d-flex align-items-center gap-3">
              <div class="info-icon" style="background:#eef2ff;color:#4f46e5;"><i class="bi bi-chat-dots"></i></div>
              <div>
                <p class="fw-semibold mb-0 small">Live Chat</p>
                <p class="text-muted mb-0 small">Available Mon–Sat, 9am–8pm</p>
              </div>
              <span class="badge bg-success ms-auto">Online</span>
            </div>
            <div class="info-box d-flex align-items-center gap-3">
              <div class="info-icon" style="background:#f0fdf4;color:#10b981;"><i class="bi bi-telephone"></i></div>
              <div>
                <p class="fw-semibold mb-0 small">Phone Support</p>
                <p class="text-muted mb-0 small">+92 300 1234567</p>
              </div>
            </div>
            <div class="info-box d-flex align-items-center gap-3">
              <div class="info-icon" style="background:#fff7ed;color:#f59e0b;"><i class="bi bi-envelope"></i></div>
              <div>
                <p class="fw-semibold mb-0 small">Email</p>
                <p class="text-muted mb-0 small">support@ntec.store</p>
              </div>
            </div>
          </div>

          <!-- Quick action links -->
          <h5 class="fw-bold mb-3">Quick Actions</h5>
          <div class="d-flex flex-column gap-2">
            <a href="/user/orders" class="btn btn-outline-primary rounded-pill text-start px-4">
              <i class="bi bi-bag me-2"></i>Track My Order
            </a>
            <a href="/user/orders" class="btn btn-outline-secondary rounded-pill text-start px-4">
              <i class="bi bi-arrow-return-left me-2"></i>Return / Refund Request
            </a>
            <a href="/user/profile" class="btn btn-outline-secondary rounded-pill text-start px-4">
              <i class="bi bi-person me-2"></i>Update My Account
            </a>
          </div>
        </div>

      </div>
    </div>

    <%- include('../partials/footer') %>
      <script src="/Bootstrap4/js/color-modes.js"></script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>

</html>