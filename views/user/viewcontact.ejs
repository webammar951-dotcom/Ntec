<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact – Ntec</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script> 
  <script src="/Bootstrap4/aos/aos.js"></script>

  <style>
    :root {
      --brand: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: 'Syne', sans-serif;
    }

    .page-header {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      color: #fff;
      padding: 40px 0;
    }

    .contact-card {
      background: #fff;
      border-radius: 24px;
      padding: 36px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, .07);
    }

    .info-box {
      background: #fff;
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
    }

    .info-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .form-control,
    .form-select {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 11px 16px;
      transition: border-color .2s;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, .08);
    }

    .btn-submit {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      border-radius: 50px;
      padding: 13px 44px;
      font-weight: 600;
      color: #fff;
      width: 100%;
    }

    .btn-submit:hover {
      opacity: .88;
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-user') %>

    
      <div class="container-fluid py-4 text-white" style="background: #4f46e5;">
        <div class="row">
          <div class="col-md-6">
             <h4 class="fw-bold mb-1">Contact Support</h4>
        <p class="mb-0 opacity-75">Need help? We're here for you 24/7.</p>
          </div>
          <div class="col-md-6">
            <button data-bs-toggle="modal" data-bs-target="#contactModal" class="btn btn-light text-primary fw-semibold rounded-pill px-4">
          <i class="fa fa-plus-circle me-1"></i> Contact
        </button>
          </div>
        </div>
      </div>
    <div class="modal fade" id="contactModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-header border-0">
            <h5 class="modal-title fw-bold">Contact</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <form action="/user_contact" method="POST" >
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label fw-medium">Name</label>
                  <input type="text" name="name" class="form-control" placeholder="Name" required>
                </div>
                <div class="col-sm-6">
                  <label class="form-label fw-medium">Email</label>
                <input type="email" name="email" id="" class="form-control"placeholder="Email">
                </div>

                <div class="col-sm-6">
                  <label class="form-label fw-medium">Subject</label>
                  <input type="text" name="subject" class="form-control" placeholder="Subject" required>
                </div>
                <div class="col-12">
                  <label class="form-label fw-medium">Message</label>
                  <textarea name="message" class="form-control" rows="3"
                    placeholder="Message…"></textarea>
                </div>
              </div>
              <div class="d-flex gap-2 justify-content-end mt-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill"
                  data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Contact</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="container-xl py-5">
      <div class="row g-5 align-items-start">

        <!-- LEFT: Contact Form -->
        <div class="col-lg-12">
         <div class="container-xl py-4">
      <form>
        <input type="text" placeholder="Search..." class="form-control" id="SearchInput">
      </form>
    


    <div class="table-card mt-5">
      <div class="table-responsive">
        <% if(result.length===0){ %>
          <h2 class="text-center text-danger"> No contact Found</h2>
          <% } else{ %>

            <table class="table products-table mb-0">
              <thead>
                <tr>
                  
                  <th>Id</th>
                  <th>Username</th>
                  <th>Email</th>
                  <th>Subject</th>
                  <th>Message</th>
                </tr>
              </thead>
              <tbody id="resultBody">
                <% for(let i=0; i < result.length; i++){ %>
                  <tr data-search="<%= result[i].username %> <%= result[i].id %> <%= result[i].category %>">
                    <td><%= result[i].id %></td>
                    <td>
                   
                      <%= result[i].username %>
                    </td>
                    <td>
                      <%= result[i].email %>
                    </td>
                    <td>
                    
                      <%= result[i].subject %>
                    </td>
                    <td>
                      <%= result[i].message %>
                    </td>
                  </tr>
                  <% } %>
              </tbody>
            </table>
            <%} %>
      </div>
      </div>
        </div>
        </div>

        
    </div>
    </div>

    <%- include('../partials/footer') %>
      <script>
        let search = document.getElementById('SearchInput')
        search.addEventListener('input', (e) => {
          const term = e.target.value.toLowerCase()
          document.querySelectorAll('#resultBody tr').forEach(rows => {
            const match = rows.dataset.search.toLowerCase().includes(term)
            rows.style.display = match ? '' : 'none'

          })
        })
      </script>
      <script src="/Bootstrap4/js/color-modes.js"></script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>

</html>