<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile – Ntec</title>
   <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
    <style>
    :root { --brand: #4f46e5; --surface: #f4f4f8; }
    body { font-family: 'Inter', sans-serif; background: var(--surface); }
    h1,h2,h3,h4 { font-family: 'Syne', sans-serif; }

    /* Profile hero banner */
    .profile-banner {
      background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      height: 180px;
      border-radius: 0 0 0 0;
    }
    /* Avatar sits on the edge of the banner */
    .avatar-wrap {
      margin-top: -60px;
    }
    .avatar-img {
      width: 110px; height: 110px;
      border-radius: 50%;
      border: 4px solid #fff;
      object-fit: cover;
      text-align: center;
      justify-content: center;
      align-items: center;
      font-size: 40px;
      background:  linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      display: flex;
      box-shadow: 0 8px 24px rgba(0,0,0,.15);
    }

    /* Tab cards */
    .profile-card {
      background: #fff;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 4px 20px rgba(0,0,0,.06);
    }
    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #e5e7eb;
      padding: 11px 16px;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(79,70,229,.08);
    }
    .btn-save {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border: none;
      border-radius: 50px;
      padding: 12px 40px;
      color: #fff;
      font-weight: 600;
    }
    .btn-save:hover { opacity: .88; }

    /* Sidebar nav */
    .profile-nav .nav-link {
      color: #374151;
      border-radius: 12px;
      padding: 12px 16px;
      font-weight: 500;
      transition: background .15s;
    }
    .profile-nav .nav-link:hover,
    .profile-nav .nav-link.active {
      background: #eef2ff;
      color: var(--brand);
    }
    .profile-nav .nav-link i { width: 20px; }

    /* Address card */
    .address-card {
      border: 2px solid #e5e7eb;
      border-radius: 16px;
      padding: 20px;
      position: relative;
      transition: border-color .2s;
    }
    .address-card.default { border-color: var(--brand); }
    .address-default-badge {
      position: absolute; top: -10px; left: 16px;
      background: var(--brand); color: #fff;
      font-size: .72rem; font-weight: 600;
      padding: 2px 10px; border-radius: 50px;
    }
  </style>
</head>
<body>

<%- include('../partials/navbar-user') %>

<!-- PROFILE BANNER -->
<div class="profile-banner"></div>

<div class="container-xl pb-5">

  <!-- PROFILE TOP ROW: avatar + name + quick stats -->
  <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-end gap-4">
      <div class="avatar-wrap">
        <div class="avatar-img text-white">
          <%= result.username[0] %> 
        </div>
      </div>
      <div class="pb-1">
        <!-- EJS:  -->
         <h4 class="fw-bold">Id # <%= result.id %></h4>
        <h4 class="fw-bold mb-0"><%= result.username %></h4>
        <p class="text-muted small mb-0"><%= result.email %> </p>
      </div>
    </div>
    <div class="d-flex gap-3 text-center pb-1">
      <div class="px-3">
        <div class="fw-bold fs-5" style="color:var(--brand);"></div>
        <div class="small text-muted">Orders</div>
      </div>
      <div class="px-3 border-start border-end">
        <div class="fw-bold fs-5" style="color:var(--brand);"></div>
        <div class="small text-muted">Wishlist</div>
      </div>
      <div class="px-3">
        <div class="fw-bold fs-5" style="color:var(--brand);"></div>
        <div class="small text-muted">Reviews</div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- SIDEBAR -->
    <div class="col-lg-3">
      <div class="profile-card">
        <nav class="profile-nav nav flex-column gap-1">
          <!-- Bootstrap tab navigation — controls tab panels on right -->
          <a class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInfo" href="#">
            <i class="bi bi-person me-2"></i>Personal Info
          </a>
          <a class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAddress" href="#">
            <i class="bi bi-geo-alt me-2"></i>Addresses
          </a>
          <a class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSecurity" href="#">
            <i class="bi bi-shield-lock me-2"></i>Security
          </a>
          <a class="nav-link" data-bs-toggle="tab" data-bs-target="#tabNotif" href="#">
            <i class="bi bi-bell me-2"></i>Notifications
          </a>
          <hr>
          <!-- Logout — no function, just UI -->
   
        </nav>
      </div>
    </div>

    <!-- MAIN TAB PANELS -->
    <div class="col-lg-9">
      <div class="tab-content">

        <!-- TAB 1: Personal Info -->
        <div class="tab-pane fade show active" id="tabInfo">
          <div class="profile-card">
            <h5 class="fw-bold mb-4">Personal Information</h5>
            <!-- NOTE: form action/method to be wired by backend -->
            <form action="/edit_personal_buyer" method="POST">
              <div class="row g-3">
                <div class="col-sm-6">
                  <label class="form-label fw-medium">Name</label>
                  <input type="text" name="username" class="form-control" value="<%= result.username %>">
                </div>
               
                <div class="col-sm-6">
                  <label class="form-label fw-medium">Email</label>
                  <input type="email" name="email" class="form-control" value="<%= result.email %>">
                </div>
               
               
                <div class="col-12 mt-2">
                  <button type="submit" class="btn-save">Save Changes</button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- TAB 2: Addresses -->
        <div class="tab-pane fade" id="tabAddress">
          <div class="profile-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h5 class="fw-bold mb-0">Saved Addresses</h5>
              <!-- Bootstrap modal trigger -->
              <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                <i class="bi bi-plus me-1"></i> Add New
              </button>
            </div>
            <div class="row g-3">
              <!-- Address 1 — Default -->
              <div class="col-md-6">
                <div class="address-card default">
                  <span class="address-default-badge">Default</span>
                  <p class="fw-semibold mb-1">Home</p>
                  <p class="text-muted small mb-0">Plot 12, Block 5<br>PECHS, Karachi 75400<br>+92 300 1234567</p>
                  <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-sm btn-outline-primary rounded-pill">Edit</button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill">Remove</button>
                  </div>
                </div>
              </div>
              <!-- Address 2 -->
              <div class="col-md-6">
                <div class="address-card">
                  <p class="fw-semibold mb-1">Office</p>
                  <p class="text-muted small mb-0">Block 6, Clifton<br>Karachi 75600<br>+92 321 9876543</p>
                  <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-sm btn-outline-primary rounded-pill">Edit</button>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill">Set Default</button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill">Remove</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: Security -->
        <div class="tab-pane fade" id="tabSecurity">
          <div class="profile-card">
            <h5 class="fw-bold mb-4">Security Settings</h5>
            <form action="/edit_password_buyer" method="POST">
              <div class="row g-3" style="max-width:480px;">
                <div class="col-12">
                  <label class="form-label fw-medium">Current Password</label>
                  <input type="password" name="currentPassword" class="form-control" placeholder="Enter current password">
                </div>
                <div class="col-12">
                  <label class="form-label fw-medium">New Password</label>
                  <input type="password" name="newpassword" class="form-control" placeholder="Min. 8 characters">
                </div>
                <div class="col-12 mt-1">
                  <h2 class="text-dangerr"><%= message %></h2>
                  <button type="submit" class="btn-save">Update Password</button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- TAB 4: Notifications -->
        <div class="tab-pane fade" id="tabNotif">
          <div class="profile-card">
            <h5 class="fw-bold mb-4">Notification Preferences</h5>
            <div class="d-flex flex-column gap-3">
              <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#f8f9ff;">
                <div>
                  <p class="fw-medium mb-0">Order Updates</p>
                  <p class="small text-muted mb-0">Get notified when your order status changes</p>
                </div>
                <div class="form-check form-switch mb-0">
                  <input type="checkbox" class="form-check-input" checked role="switch">
                </div>
              </div>
              <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#f8f9ff;">
                <div>
                  <p class="fw-medium mb-0">Promotional Emails</p>
                  <p class="small text-muted mb-0">Deals, new products and offers</p>
                </div>
                <div class="form-check form-switch mb-0">
                  <input type="checkbox" class="form-check-input" role="switch">
                </div>
              </div>
              <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background:#f8f9ff;">
                <div>
                  <p class="fw-medium mb-0">SMS Alerts</p>
                  <p class="small text-muted mb-0">Receive SMS for delivery updates</p>
                </div>
                <div class="form-check form-switch mb-0">
                  <input type="checkbox" class="form-check-input" checked role="switch">
                </div>
              </div>
              <button class="btn-save w-auto mt-2" style="width:auto; display:inline-block;">Save Preferences</button>
            </div>
          </div>
        </div>

      </div><!-- /tab-content -->
    </div><!-- /col -->
  </div><!-- /row -->
</div>

<!-- ADD ADDRESS MODAL -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form>
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-medium">Label</label>
              <input type="text" class="form-control" placeholder="e.g. Home, Office">
            </div>
            <div class="col-12">
              <label class="form-label fw-medium">Street Address</label>
              <input type="text" class="form-control" placeholder="Plot, Street, Area">
            </div>
            <div class="col-sm-6">
              <label class="form-label fw-medium">City</label>
              <input type="text" class="form-control" placeholder="Karachi">
            </div>
            <div class="col-sm-6">
              <label class="form-label fw-medium">Postal Code</label>
              <input type="text" class="form-control" placeholder="75400">
            </div>
            <div class="col-12">
              <div class="form-check">
                <input type="checkbox" class="form-check-input" id="setDefault">
                <label class="form-check-label" for="setDefault">Set as default address</label>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary rounded-pill" data-bs-dismiss="modal">Save Address</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/Bootstrap4/js/color-modes.js"></script>
<script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
<!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>
</html>
