<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop – Ntec</title>
  <link rel="stylesheet" href="/Bootstrap4/css/bootstrap.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/all.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/fontawesome.css" />
  <link rel="stylesheet" href="/Bootstrap4/fontawesome/css/brands.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.carousel.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/css/owl.theme.default.min.css" />
  <link rel="stylesheet" href="/Bootstrap4/aos/aos.css" />

  <script src="/Bootstrap4/js/jquery-3.6.0.min.js"></script>
  <script src="/Bootstrap4/js/owl.carousel.min.js"></script>
  <script src="/Bootstrap4/js/owl-carousel-option.js"></script>
  <script src="/Bootstrap4/aos/aos.js"></script>
  <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"> -->
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet">
  <style>
    .font-arial {
      font-family: arial;
    }

    :root {
      --brand: #4f46e5;
      --surface: #f4f4f8;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: 'Syne', sans-serif;
    }

    /* Welcome banner */
    .welcome-banner {
      background: linear-gradient(90deg, #4f46e5, #7c3aed);
      border-radius: 20px;
      padding: 32px;
      color: #fff;
    }

    /* Product card */
    .product-card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, .06);
      transition: transform .25s, box-shadow .25s;
      height: 100%;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 36px rgba(79, 70, 229, .14);
    }

    .product-img-wrap {
      background: var(--surface);
      padding: 24px;
      text-align: center;
      position: relative;
    }

    .product-img-wrap img {
      height: 150px;
      object-fit: contain;
    }

    .badge-new {
      position: absolute;
      top: 10px;
      left: 10px;
    }

    /* Wishlist heart button */
    .btn-wish {
      position: absolute;
      top: 10px;
      right: 10px;
      background: #fff;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, .1);
      border: none;
      color: #ccc;
      transition: color .2s;
    }

    .hero-badge {
      background: rgba(79, 70, 229, .1);
      color: var(--brand);
      border-radius: 50px;
      padding: 4px 14px;
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .04em;
    }

    .btn-wish:hover {
      color: #ef4444;
    }

    /* Filter sidebar */
    .filter-card {
      background: #fff;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .05);
    }

    .range-value {
      font-weight: 600;
      color: var(--brand);
    }

    /* Sort bar */
    .sort-bar {
      background: #fff;
      border-radius: 14px;
      padding: 14px 20px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }
  </style>
</head>

<body>

  <%- include('../partials/navbar-user') %>

    <div class="container-xl py-4">

      <!-- Welcome Banner -->
      <div class="welcome-banner mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <!-- EJS variable: user.name will be injected by backend -->
          <h4 class="fw-bold mb-1">Welcome back, <%= user ? user : 'Shopper' %>! 👋</h4>
          <p class="mb-0 opacity-75">Discover today's featured products and exclusive deals.</p>
        </div>
        <a href="/buyer_orders" class="btn btn-light text-primary fw-semibold rounded-pill px-4">
          <i class="bi bi-bag-check me-1"></i> My Orders
        </a>
      </div>

      <div class="row g-4">

        <!-- SIDEBAR FILTERS — hidden on mobile, shown on lg+ -->
        <div class="col-lg-3 d-none d-lg-block">
          <div class="filter-card mb-3">
            <h6 class="fw-bold mb-3">Category</h6>
            <div class="d-flex flex-column gap-2">
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catAll" checked><label
                  class="form-check-label" for="catAll">All Products</label></div>
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catHead"><label
                  class="form-check-label" for="catHead">Headphones</label></div>
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catEar"><label
                  class="form-check-label" for="catEar">Earbuds</label></div>
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catVr"><label
                  class="form-check-label" for="catVr">VR Headsets</label></div>
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catSpk"><label
                  class="form-check-label" for="catSpk">Speakers</label></div>
              <div class="form-check"><input type="radio" class="form-check-input" name="cat" id="catWear"><label
                  class="form-check-label" for="catWear">Wearables</label></div>
            </div>
          </div>

          <div class="filter-card mb-3">
            <h6 class="fw-bold mb-3">Price Range</h6>
            <input type="range" class="form-range" min="0" max="1000" value="500" id="priceRange">
            <div class="d-flex justify-content-between small text-muted">
              <span>$0</span>
              <span class="range-value">$500</span>
              <span>$1000</span>
            </div>
          </div>

          <div class="filter-card">
            <h6 class="fw-bold mb-3">Brand</h6>
            <div class="d-flex flex-column gap-2">
              <div class="form-check"><input type="checkbox" class="form-check-input" id="bSony" checked><label
                  class="form-check-label" for="bSony">Sony</label></div>
              <div class="form-check"><input type="checkbox" class="form-check-input" id="bBose"><label
                  class="form-check-label" for="bBose">Bose</label></div>
              <div class="form-check"><input type="checkbox" class="form-check-input" id="bSamsung"><label
                  class="form-check-label" for="bSamsung">Samsung</label></div>
              <div class="form-check"><input type="checkbox" class="form-check-input" id="bApple"><label
                  class="form-check-label" for="bApple">Apple</label></div>
              <div class="form-check"><input type="checkbox" class="form-check-input" id="bJBL"><label
                  class="form-check-label" for="bJBL">JBL</label></div>
            </div>
          </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-9">
          <div class="sort-bar d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">

            <form action="/search_product" class="input-group" method="post">
              <input type="text" name="se" placeholder="Search Products" class="form-control">
              <button type="submit" class="btn btn-outline-primary btn-sm  ">
                <i class="fa fa-search"></i>
              </button>
            </form>


          </div>
          <!-- /product row -->
          <div class="container">
            <div class="row row-cols-2  ">
              <% for(let i=0 ; i < result.length; i++){ %>
                <% if(result.length === 0){ %>
                  <div class="d-flex justify-content-center">
                    <h2 class="text-primary">Loading...</h2>
                  </div>
                  <% } %>
                    <div class="col-md-3 col-6 mt-4">
                      <div class="product-card position-relative">
                        <div class="product-img-wrap">
                          <button class="btn-wish"><i class="fa fa-heart"></i></button>
                          <img src="/products/<%= result[i].image %>" class="img-fluid" alt="">
                        </div>
                        <p class="text-center">
                          <%= result[i].product %>
                        </p>
                        <div class="my-3 mx-3">
                          <span class="hero-badge">
                            <%= result[i].category %>
                          </span>
                        </div>
                        <div class="text-start px-3">
                          <h3 style="color: #7c3aed;" data-usd="<%= result[i].price %>"
                            class="font-arial product-price  fs-3">
                            $<%= result[i].price %>

                          </h3>
                        </div>
                        <div class="d-flex px-4 py-2 justify-content-end align-items-end">
                          <button class="btn btn-lg btn-primary"> <a class="text-decoration-none text-white"
                              href="/buy/<%= result[i].id %>">Buy</a></button>
                        </div>
                      </div>
                    </div>
                    <% } %>
            </div>
          </div>
          <!-- Pagination -->
         <nav class="mt-5 d-flex flex-wrap justify-content-center">
  <ul class="pagination d-flex flex-wrap" id="paginationList">

    <%
      const pagesPerBlock = 15;
      const currentPage   = Number(page);
      const maxBlock      = Math.ceil(totalPages / pagesPerBlock);
      const currentBlock  = Math.ceil(currentPage / pagesPerBlock);
    %>

    <li class="page-item fw-bold <%= currentPage === 1 ? 'disabled' : '' %>">
      <a class="page-link rounded-end-pill" href="?page=<%= currentPage - 1 %>">«</a>
    </li>

    <li class="page-item <%= currentBlock <= 1 ? 'd-none' : '' %>" id="prevBlockBtn">
      <a href="#" class="page-link">...</a>
    </li>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <li
        class="page-item pagination-number <%= i === currentPage ? 'active' : '' %> <%= Math.ceil(i / pagesPerBlock) === currentBlock ? '' : 'd-none' %>"
        data-block="<%= Math.ceil(i / pagesPerBlock) %>"
      >
        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
      </li>
    <% } %>

    <li class="page-item <%= currentBlock >= maxBlock ? 'd-none' : '' %>" id="nextBlockBtn">
      <a href="#" class="page-link">...</a>
    </li>

    <li class="page-item fw-bold <%= currentPage >= totalPages ? 'disabled' : '' %>">
      <a class="page-link rounded-end-pill" href="?page=<%= currentPage + 1 %>">»</a>
    </li>

  </ul>
</nav>

        </div><!-- /main col -->
      </div><!-- /row -->
    </div><!-- /container -->

    <!-- MOBILE FILTER OFFCANVAS (Bootstrap offcanvas, no JS needed) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="filterOffcanvas">
      <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold">Filters</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <h6 class="fw-semibold mb-3">Category</h6>
        <div class="d-flex flex-column gap-2 mb-4">
          <div class="form-check"><input type="radio" class="form-check-input" name="mCat" checked><label
              class="form-check-label">All Products</label></div>
          <div class="form-check"><input type="radio" class="form-check-input" name="mCat"><label
              class="form-check-label">Headphones</label></div>
          <div class="form-check"><input type="radio" class="form-check-input" name="mCat"><label
              class="form-check-label">Earbuds</label></div>
          <div class="form-check"><input type="radio" class="form-check-input" name="mCat"><label
              class="form-check-label">VR Headsets</label></div>
        </div>
        <h6 class="fw-semibold mb-3">Price</h6>
        <input type="range" class="form-range mb-4" min="0" max="1000" value="500">
        <button class="btn btn-primary w-100 rounded-pill" data-bs-dismiss="offcanvas">Apply Filters</button>
      </div>
    </div>

    <!-- CART TOAST — Bootstrap toast, no custom JS -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div id="cartToast" class="toast align-items-center text-bg-success border-0">
        <div class="d-flex">
          <div class="toast-body"><i class="bi bi-bag-check me-2"></i> Added to cart!</div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>
      <script>
        (function () {
          const perBlock = <%= pagesPerBlock %>;
          const maxBlock = <%= maxBlock %>;
          let visibleBlock = <%= currentBlock %>;

          const numberEls = document.querySelectorAll('#paginationList .pagination-number');
          const prevBtn = document.getElementById('prevBlockBtn');
          const nextBtn = document.getElementById('nextBlockBtn');

          function render() {
            numberEls.forEach(function (li) {
              li.classList.toggle('d-none', Number(li.dataset.block) !== visibleBlock);
            });
            prevBtn.classList.toggle('d-none', visibleBlock <= 1);
            nextBtn.classList.toggle('d-none', visibleBlock >= maxBlock);
          }

          prevBtn.addEventListener('click', function (e) {
            e.preventDefault();
            visibleBlock--;
            render();
          });

          nextBtn.addEventListener('click', function (e) {
            e.preventDefault();
            visibleBlock++;
            render();
          });
        })();
      </script>
      <script src="/Bootstrap4/js/color-modes.js">
      </script>
      <script src="/Bootstrap4/js/bootstrap.bundle.js"></script>
      <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>

</html>