<script>
  let rates = {}

  async function get() {
    try {
      const res = await fetch('https://v6.exchangerate-api.com/v6/a4c19dd4e3d5cc6bf30b048b/latest/USD')
      const data = await res.json();
      rates = data.conversion_rates;
    }
    catch (e) {
 localStorage.setItem('key','usd')
      document.querySelectorAll('.product-price').forEach(el => {
        const usd = el.dataset.usd
        el.textContent = `$${usd}`
      })
      const btn_pkr = document.getElementById('btn-pkr')
      btn_pkr.style.display = "none"
     check.innerHTML=`<p class=" fs-6">Please check your internet connection</p>`

    }



    if (localStorage.getItem('key') === 'pak') {
      document.querySelectorAll('.product-price').forEach(el => {
        const usd = el.dataset.usd
        const pkr = (usd * rates.PKR).toFixed(0)

        const P = Number(pkr).toLocaleString()
        el.textContent = `Rs ${P}`
      })
    }
    if (localStorage.getItem('key') === 'usd') {
      document.querySelectorAll('.product-price').forEach(el => {
        const usd = el.dataset.usd
        el.textContent = `$${usd}`
      })
    }
    document.querySelectorAll('.product-price').forEach(el => {
      el.style.visibility = 'visible'
    })
   

  }

  // USD button clicked
  document.getElementById('btn-usd').addEventListener('click', () => {
    document.querySelectorAll('.product-price').forEach(el => {
      const usd = el.dataset.usd
      el.textContent = `$${usd}`
    })
    localStorage.setItem('key', 'usd')
    location.reload()
  })

  // PKR button clicked
  document.getElementById('btn-pkr').addEventListener('click', () => {
    document.querySelectorAll('.product-price').forEach(el => {
      const usd = el.dataset.usd
      const pkr = (usd * rates.PKR).toFixed(0)
      const P = Number(pkr).toLocaleString()
      el.textContent = `Rs ${P}`

    })
    localStorage.setItem('key', 'pak')
    location.reload()
  })


  get()



</script>